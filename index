<style>
  :root { --paper:#f6f7f9; --card:#ffffff; --ink:#14213d; --muted:#586174; --line:#d5dbe4; --accent:#2457d6; --ok:#1f9d6b; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--paper); color:var(--ink); font:17px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
  a { color:var(--accent); }
  a:focus-visible, .btn:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
  .wrap { max-width:860px; margin:0 auto; padding:0 24px; }
  h1, h2, h3 { font-family:Georgia, "Times New Roman", serif; line-height:1.15; margin:0; }
  header.hero { padding:72px 0 48px; border-bottom:1px solid var(--line); }
  h1 { font-size:clamp(2.6rem, 8vw, 4.2rem); letter-spacing:-.02em; }
  .role { margin:14px 0 0; font-size:1.2rem; color:var(--accent); font-weight:600; }
  .intro { max-width:60ch; margin:20px 0 28px; color:var(--muted); }
  .actions { display:flex; gap:12px; flex-wrap:wrap; }
  .btn { display:inline-block; padding:11px 20px; border-radius:6px; text-decoration:none; font-weight:600; border:2px solid var(--accent); }
  .btn.primary { background:var(--accent); color:#fff; }
  .btn.ghost { color:var(--accent); }
  section { padding:52px 0 0; }
  h2 { font-size:1.7rem; margin-bottom:22px; }
  /* pipeline */
  .pipeline { list-style:none; margin:0; padding:0 0 0 34px; position:relative; }
  .pipeline::before { content:""; position:absolute; left:9px; top:8px; bottom:8px; width:2px; background:var(--line); }
  .stage { position:relative; background:var(--card); border:1px solid var(--line); border-radius:8px; padding:20px 22px; margin-bottom:18px; }
  .stage::before { content:""; position:absolute; left:-33px; top:24px; width:16px; height:16px; border-radius:50%; background:var(--ok); border:3px solid var(--paper); }
  .stage.running::before { background:var(--accent); box-shadow:0 0 0 3px rgba(36,87,214,.25); }
  .status { font:600 .78rem ui-monospace, "SF Mono", Consolas, monospace; color:var(--ok); }
  .running .status { color:var(--accent); }
  .stage h3 { font-size:1.25rem; margin:4px 0 2px; }
  .meta { color:var(--muted); font-size:.95rem; margin:0 0 10px; }
  .stage ul { margin:0; padding-left:1.15rem; }
  .stage li { margin-bottom:4px; }
  .sub { margin:14px 0 4px; font-weight:600; font-size:1rem; }
  /* skills */
  .skills { display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px; }
  .skill { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:16px 18px; }
  .skill h3 { font-size:1rem; margin-bottom:6px; font-family:system-ui, sans-serif; }
  .skill p { margin:0; color:var(--muted); font-size:.97rem; }
  footer { margin-top:64px; padding:32px 0 56px; border-top:1px solid var(--line); color:var(--muted); }
  footer p { margin:0 0 6px; }
  @media (max-width:520px) { body { font-size:16px; } header.hero { padding-top:48px; } }
</style>
</head>
